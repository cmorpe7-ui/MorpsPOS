<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧾 Receipt Preview (58mm Thermal)"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="Here is how the receipt will print on 58mm thermal paper:"
            android:textColor="@color/colorTextMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_receipt_preview_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/receipt_paper_background"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="[Loading receipt preview...]"
            android:textColor="@color/colorTextDark"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_close_preview"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_tonal"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="Close"
                android:textColor="@color/colorTextDark"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_print_from_preview"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.6"
                android:background="@drawable/button_primary"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="🖨️ Print Now"
                android:textColor="@color/colorOnPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
