<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- TOP ROW: NAME, CATEGORY, & EDIT BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_inv_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pancit Canton"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_inv_item_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Noodles"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_inv_stock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/badge_green"
            android:text="In Stock: 36"
            android:textColor="@color/colorBadgeGreenText"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_inv_edit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/button_chip"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✏️"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#F1F5F9" />

    <!-- BOTTOM ROW: PRICES & QUICK RESTOCK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_inv_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selling: ₱18.00"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_inv_item_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Cost: ₱14.50 • Profit: +₱3.50"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quick restock chips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Add:"
            android:textColor="@color/colorTextMuted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_inv_restock_5"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_chip"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="+5"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_inv_restock_10"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/button_chip"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="+10"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
