<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- HEADER: RECEIPT NO & PAYMENT BADGE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_sale_receipt_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MORPS-1001"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_sale_date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="2026-10-22 17:15"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_sale_payment_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_green"
            android:text="CASH"
            android:textColor="@color/colorBadgeGreenText"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#F1F5F9" />

    <!-- ITEMS SUMMARY & TOTAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_sale_items_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1x Pancit Canton, 2x Coke Mismo"
                android:textColor="@color/colorTextDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_sale_customer_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Note: Aling Marites"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_sale_total_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱58.00"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ACTIONS ROW: RE-PRINT & SETTLE CREDIT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_settle_credit"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_chip"
            android:minHeight="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Mark as Paid"
            android:textColor="@color/colorSuccess"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_reprint_receipt"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/button_chip"
            android:minHeight="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="🔄 Re-print"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
