<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_pos_product_grid"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_margin="4dp"
    android:background="@drawable/card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Row: Category and Stock Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_pos_product_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="General"
            android:textColor="@color/colorTextMuted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_pos_stock_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_green"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="Stock: 10"
            android:textColor="@color/colorBadgeGreenText"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Product Name (min 2 lines to maintain uniform card height across the grid) -->
    <TextView
        android:id="@+id/text_pos_product_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:lines="2"
        android:maxLines="2"
        android:text="Product Name"
        android:textColor="@color/colorTextDark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Bottom Row: Price and Add Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_pos_product_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="₱0.00"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_pos_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/button_tonal"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
