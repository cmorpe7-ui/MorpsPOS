<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER & PRINTER STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_main_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Morps POS 🛒"
                        android:textColor="@color/colorPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_main_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sari-Sari Store POS &amp; Inventory • 58mm Thermal"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/button_customize_receipt"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/button_chip"
                    android:minHeight="0dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="⚙️ Customize"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#EEEEEE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_printer_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🖨️ Printer: Default Bluetooth"
                    android:textColor="@color/colorTextDark"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/button_bluetooth_browse"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/button_chip"
                    android:minHeight="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="Select Printer"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- NAVIGATION TABS: POS vs INVENTORY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/tab_pos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:minHeight="0dp"
                android:text="🛒 POS"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tab_inventory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:minHeight="0dp"
                android:text="📦 Stocks"
                android:textColor="@color/colorTextDark"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tab_sales"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:minHeight="0dp"
                android:text="📊 Sales"
                android:textColor="@color/colorTextDark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ========================================================================= -->
        <!-- VIEW 1: POS CHECKOUT TAB -->
        <!-- ========================================================================= -->
        <LinearLayout
            android:id="@+id/layout_pos_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PRODUCT CATALOG & SEARCH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Product Catalog"
                        android:textColor="@color/colorTextDark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_pos_low_stock_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_orange"
                        android:text="⚠️ 0 Low Stock"
                        android:textColor="@color/colorBadgeOrangeText"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Search bar for POS -->
                <EditText
                    android:id="@+id/edit_pos_search"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext_border"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:hint="Search item to sell..."
                    android:inputType="text"
                    android:textSize="13sp" />

                <!-- Category filter chips horizontal container -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_pos_categories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Dynamic POS Products List Container -->
                <LinearLayout
                    android:id="@+id/layout_pos_products_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Custom / Retail item manual input -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="#EEEEEE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Or add unlisted / tingi item:"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edittext_custom_name"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1.6"
                        android:background="@drawable/edittext_border"
                        android:hint="Name (e.g. Sugar)"
                        android:inputType="text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edittext_custom_price"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_border"
                        android:hint="Price ₱"
                        android:inputType="numberDecimal"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/button_add_custom"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/button_accent"
                        android:minHeight="0dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="+ Add"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CART / ORDER SUMMARY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Current Cart"
                        android:textColor="@color/colorTextDark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/button_clear_cart"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:minHeight="0dp"
                        android:text="Clear Cart"
                        android:textColor="@color/colorDanger"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_empty_cart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="Cart is empty. Select items from above."
                    android:textColor="@color/colorTextMuted"
                    android:textSize="13sp" />

                <!-- Dynamic Cart Items Container -->
                <LinearLayout
                    android:id="@+id/layout_cart_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#DDDDDD" />

                <!-- Total Amount Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOTAL AMOUNT:"
                        android:textColor="@color/colorTextDark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_cart_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱ 0.00"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- PAYMENT & CHANGE CALCULATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method"
                    android:textColor="@color/colorTextDark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radiogroup_payment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radio_cash"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="💵 Cash"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radio_gcash"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📱 GCash"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radio_utang"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📝 Store Credit"
                        android:textSize="13sp" />
                </RadioGroup>

                <!-- Quick Cash Tender Suggestion Chips -->
                <LinearLayout
                    android:id="@+id/layout_quick_cash_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/chip_cash_exact"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_chip"
                        android:minHeight="0dp"
                        android:text="Exact"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/chip_cash_50"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_chip"
                        android:minHeight="0dp"
                        android:text="₱50"
                        android:textColor="@color/colorTextDark"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/chip_cash_100"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_chip"
                        android:minHeight="0dp"
                        android:text="₱100"
                        android:textColor="@color/colorTextDark"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/chip_cash_500"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_chip"
                        android:minHeight="0dp"
                        android:text="₱500"
                        android:textColor="@color/colorTextDark"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/chip_cash_1000"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_chip"
                        android:minHeight="0dp"
                        android:text="₱1000"
                        android:textColor="@color/colorTextDark"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Cash tendered & change block -->
                <LinearLayout
                    android:id="@+id/layout_cash_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Cash Received:"
                        android:textColor="@color/colorTextDark"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edittext_cash_tendered"
                        android:layout_width="110dp"
                        android:layout_height="40dp"
                        android:background="@drawable/edittext_border"
                        android:hint="₱ 0.00"
                        android:inputType="numberDecimal"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_change"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Change: ₱ 0.00"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Customer Name or Note -->
                <EditText
                    android:id="@+id/edittext_customer_note"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Customer Name / GCash Ref (Optional)"
                    android:inputType="text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- PRINT & ACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/button_preview_receipt"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/button_accent"
                    android:text="👁️ Preview Receipt"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_bluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/button_primary"
                    android:text="🖨️ PRINT RECEIPT (Bluetooth 58mm)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button_usb"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_chip"
                        android:text="🔌 Print via USB"
                        android:textColor="@color/colorTextDark"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/button_new_sale"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_chip"
                        android:text="✨ Complete / New Sale"
                        android:textColor="@color/colorTextDark"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <!-- ========================================================================= -->
        <!-- VIEW 2: INVENTORY & STOCK MANAGEMENT TAB -->
        <!-- ========================================================================= -->
        <LinearLayout
            android:id="@+id/layout_inventory_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- INVENTORY OVERVIEW METRICS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Overview"
                    android:textColor="@color/colorTextDark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_inv_metric_products"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/colorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Products"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_inv_metric_stock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/colorTextDark"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Units"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_inv_metric_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inventory Value"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Warning banner for low stocks -->
                <TextView
                    android:id="@+id/banner_inv_low_stock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/badge_orange"
                    android:padding="8dp"
                    android:text="⚠️ 0 items are low in stock! Tap restock below."
                    android:textColor="@color/colorBadgeOrangeText"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- INVENTORY ACTIONS & SEARCH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_inventory_search"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_border"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:hint="Search products..."
                    android:inputType="text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_inventory_add"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/button_primary"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="+ Add Item"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- DYNAMIC INVENTORY LIST CONTAINER -->
            <LinearLayout
                android:id="@+id/layout_inventory_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ========================================================================= -->
        <!-- VIEW 3: SALES HISTORY & DAILY Z-REPORT TAB -->
        <!-- ========================================================================= -->
        <LinearLayout
            android:id="@+id/layout_sales_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- TODAY'S SALES & CASH FLOW METRICS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Today's Performance"
                        android:textColor="@color/colorTextDark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_sales_today_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_green"
                        android:paddingLeft="8dp"
                        android:paddingTop="2dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="2dp"
                        android:text="Today"
                        android:textColor="@color/colorBadgeGreenText"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Primary Revenue Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_sales_today_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Gross Sales"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_sales_today_orders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/colorTextDark"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transactions"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#F1F5F9" />

                <!-- Payment Breakdowns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_sales_today_cash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/colorSuccess"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💵 Cash"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_sales_today_gcash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱 GCash"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_sales_unpaid_credit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/colorDanger"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📝 Unpaid Credit"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- PRINT DAILY Z-REPORT BUTTON -->
                <Button
                    android:id="@+id/btn_print_z_report"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_accent"
                    android:text="🖨️ Print Daily Z-Report (58mm)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SALES FILTER BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/radiogroup_sales_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radio_filter_all_sales"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="All Sales"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radio_filter_unpaid_credit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Unpaid Credit Only"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>

            <TextView
                android:id="@+id/text_sales_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="No transactions recorded yet."
                android:textColor="@color/colorTextMuted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- DYNAMIC SALES LIST CONTAINER -->
            <LinearLayout
                android:id="@+id/layout_sales_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>